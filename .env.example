# Скопируйте в .env и вставьте ключ: https://openrouter.ai/settings/keys
# Файл .env не попадает в git.
OPENROUTER_API_KEY=
# Основная: проверка требований, набора и финтех-сценариев
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Лёгкая: выделение требований и исправления
LLM_LIGHT_MODEL=nvidia/nemotron-3.5-super-vl:free
# Независимая проверка замечаний
LLM_VALIDATOR_MODEL=nvidia/nemotron-3.5-super-vl:free
# Запасные через запятую
LLM_FALLBACK_MODELS=inclusionai/ling-3.2-flash:free,particle-ai/particle-1:free,google/gemma-4-31b-it:free

# Google Gemini (запасной вариант): ключ на https://aistudio.google.com/apikey
# Если OPENROUTER_API_KEY пуст, проверка идёт на Gemini. Если заданы оба ключа, Gemini подхватывает запросы,
# когда модели OpenRouter недоступны. LLM_PROVIDER=gemini ставит Gemini первым.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Запросов в минуту к Gemini (бесплатный тариф ограничен)
GEMINI_RPM=10
LLM_PROVIDER=auto

# Используется, если проект запущен вне git-репозитория
AGENT_VERSION=0.1.0

MAX_FILE_SIZE_MB=10
# Секунды: сколько ждать очередной фрагмент ответа модели и весь анализ
LLM_TIMEOUT=90
ANALYSIS_TIMEOUT=1800
# Повторы на одной модели, затем запрос уходит следующей
MAX_RETRIES=1

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
