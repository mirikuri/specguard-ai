# Скопируйте в .env и вставьте ключ: https://aistudio.google.com/apikey
# Файл .env не попадает в git.
GEMINI_API_KEY=
# Основная: проверка требований, набора и финтех-сценариев
GEMINI_MODEL=gemini-3.8-flash
# Лёгкая: выделение требований и исправления
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
# Независимая проверка замечаний
GEMINI_VALIDATOR_MODEL=gemini-3.6-flash
# Запасные через запятую
GEMINI_FALLBACK_MODELS=gemini-4-hydrogen,gemini-3.5-flash,gemma-4-31b-it,gemma-4-26b-a4b-it,gemini-3.1-flash-lite

# Используется, если проект запущен вне git-репозитория
AGENT_VERSION=0.1.0

MAX_FILE_SIZE_MB=10
# Секунды: один запрос к модели и весь анализ
LLM_TIMEOUT=120
ANALYSIS_TIMEOUT=900
# Повторы на одной модели (не больше 2), затем запрос уходит следующей
MAX_RETRIES=1
# Пауза между запросами, секунды (лимиты бесплатного тарифа)
LLM_MIN_INTERVAL=4

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
